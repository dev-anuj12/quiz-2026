{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/participant", "destination": "/register.html" },
    { "source": "/participant.html", "destination": "/register.html" },
    { "source": "/join", "destination": "/register.html" },
    { "source": "/join.html", "destination": "/register.html" },
    { "source": "/play", "destination": "/register.html" },
    { "source": "/play.html", "destination": "/register.html" },
    { "source": "/team", "destination": "/register.html" },
    { "source": "/team.html", "destination": "/register.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/socket.io/(.*)", "destination": "/api/index.js" }
  ]
}

